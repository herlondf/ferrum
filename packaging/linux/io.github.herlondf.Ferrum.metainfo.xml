<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>io.github.herlondf.Ferrum</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>MIT OR Apache-2.0</project_license>
  <name>Ferrum</name>
  <summary>A fast, cross-platform Git client</summary>
  <developer id="io.github.herlondf">
    <name>Herlon D. Filgueira</name>
  </developer>
  <description>
    <p>
      Ferrum is a Git client for Linux, Windows and macOS. It shows the history
      as a graph, lets you stage files, hunks and lines, commit, branch, merge,
      rebase interactively, resolve conflicts and work with GitHub and GitLab
      pull requests.
    </p>
    <ul>
      <li>History graph with search, commit details and diffs</li>
      <li>Staging of whole files, hunks or single lines</li>
      <li>Fetch, pull and push with live progress, and an activity log of every git command</li>
      <li>Interactive rebase, conflict resolution, stashes, tags, worktrees and submodules</li>
      <li>GitHub and GitLab pull requests</li>
    </ul>
  </description>
  <launchable type="desktop-id">ferrum.desktop</launchable>
  <url type="homepage">https://herlondf.github.io/ferrum/</url>
  <url type="bugtracker">https://github.com/herlondf/ferrum/issues</url>
  <url type="vcs-browser">https://github.com/herlondf/ferrum</url>
  <url type="translate">https://github.com/herlondf/ferrum/tree/main/crates/ferrum-app/src/i18n</url>
  <screenshots>
    <screenshot type="default">
      <caption>The history graph with commit details and a diff</caption>
      <image type="source" width="1440" height="900">https://raw.githubusercontent.com/herlondf/ferrum/main/site/assets/screenshots/history-en-dark.png</image>
    </screenshot>
    <screenshot>
      <caption>Staging single lines in the local changes view</caption>
      <image type="source" width="1440" height="900">https://raw.githubusercontent.com/herlondf/ferrum/main/site/assets/screenshots/changes-en-light.png</image>
    </screenshot>
    <screenshot>
      <caption>A side-by-side diff in the large view</caption>
      <image type="source" width="1440" height="900">https://raw.githubusercontent.com/herlondf/ferrum/main/site/assets/screenshots/diff-en-dark.png</image>
    </screenshot>
  </screenshots>
  <branding>
    <color type="primary" scheme_preference="light">#f6c6a6</color>
    <color type="primary" scheme_preference="dark">#6b2f12</color>
  </branding>
  <categories>
    <category>Development</category>
    <category>RevisionControl</category>
  </categories>
  <keywords>
    <keyword>git</keyword>
    <keyword>version control</keyword>
  </keywords>
  <provides>
    <binary>ferrum</binary>
  </provides>
  <requires>
    <display_length compare="ge">768</display_length>
  </requires>
  <supports>
    <control>pointing</control>
    <control>keyboard</control>
  </supports>
  <content_rating type="oars-1.1"/>
  <releases>
    <release version="0.1.0" date="2026-11-06">
      <description>
        <p>First release.</p>
        <ul>
          <li>History graph, commit details, diffs and blame</li>
          <li>Staging of files, hunks and lines; commit, amend and push</li>
          <li>Interactive rebase, three-way conflict resolver and undo</li>
          <li>GitHub, GitLab, Bitbucket, Azure DevOps and Gitea pull requests and issues</li>
          <li>Dark, light and high-contrast themes; English and Brazilian Portuguese</li>
        </ul>
      </description>
    </release>
  </releases>
</component>
